rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // who is signed in (Google or email link; the address must be verified)
    function email() {
      return request.auth != null && request.auth.token.email_verified == true ? request.auth.token.email.lower() : '';
    }
    // Basel: the only person who can see and change everything
    function isAdmin() {
      return email() in ['basel.algamal@icloud.com', 'basel.algamal88@gmail.com'];
    }
    // the agent key mapped to this email in /access (set by Basel), or '' if none
    function myAgent() {
      return email() != '' && exists(/databases/$(database)/documents/access/$(email()))
        ? get(/databases/$(database)/documents/access/$(email())).data.ak : '';
    }
    match /access/{e} {
      allow read: if isAdmin() || e == email();
      allow write: if isAdmin();
    }
    // each agent's data, readable only by that agent and Basel
    match /agents/{ak}/parts/{p} {
      allow read: if isAdmin() || (myAgent() != '' && myAgent() == ak);
      allow write: if isAdmin();
    }
    // the full team data, Basel only
    match /admin/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /meta/{d} {
      allow read: if isAdmin() || myAgent() != '';
      allow write: if isAdmin();
    }
    // lead changes made by Basel's admin in the Google Sheet (written by the sheet's script as Basel)
    match /changes/{id} {
      allow read: if isAdmin() || (myAgent() != '' && (resource.data.ak == myAgent() || resource.data.from == myAgent()));
      allow write: if isAdmin();
    }
    // phones that turned on notifications: each person registers only their own device; only Basel (and the sheet's script) reads them
    match /tokens/{t} {
      allow read: if isAdmin();
      allow create, update: if email() != '' && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['email', 'ak', 'admin', 'ua', 'at'])
        && (isAdmin() || (request.resource.data.ak == myAgent() && request.resource.data.admin == false));
      allow delete: if isAdmin() || resource.data.email == email();
    }
    // Rotation and Cold calls tabs from Basel's sheet: each agent reads only their own rows ('all' = Basel)
    match /lists/{d} {
      allow read: if isAdmin() || (myAgent() != '' && resource.data.ak == myAgent());
      allow write: if isAdmin();
    }
    // leads reassigned to each agent ('all' = Basel)
    match /reassigned/{d} {
      allow read: if isAdmin() || (myAgent() != '' && d == myAgent());
      allow write: if isAdmin();
    }
    // each person's own settings (their WhatsApp greeting)
    match /prefs/{e} {
      allow read, write: if email() != '' && e == email();
    }
    // Basel's app settings (whether agents see sales); everyone signed in reads them
    match /settings/{d} {
      allow read: if isAdmin() || myAgent() != '';
      allow write: if isAdmin();
    }
    // feedback agents log in the app
    match /updates/{id} {
      allow read: if isAdmin() || (myAgent() != '' && resource.data.ak == myAgent());
      allow create: if isAdmin() || (myAgent() != ''
        && request.resource.data.ak == myAgent()
        && request.resource.data.by == email()
        && request.resource.data.keys().hasOnly(['ak', 'lead', 'client', 'phone', 'feedback', 'note', 'next', 'at', 'by', 'src', 'kind', 'project', 'source'])
        && request.resource.data.note is string && request.resource.data.note.size() < 2000
        && request.resource.data.client is string && request.resource.data.client.size() < 200);
      allow update, delete: if isAdmin();
    }
  }
}
